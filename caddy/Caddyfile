{
	admin off
	auto_https off
}

:8080 {
	# Operator paths never reach the site or its SPA fallback (design 3.6, ADR 0002).
	@operator path /admin* /review /review/*
	handle @operator {
		respond 404
	}

	# Server-sent events: no response buffering (design 3.8).
	handle /v1/stream {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	handle /v1/* {
		reverse_proxy api:8080
	}

	# The signed-in SPA (technical design 1.x): hashed assets are immutable, a missing one is a real 404,
	# and any other /app path is a client-side route, so it gets index.html, never cached.
	handle /app/assets/* {
		root * /srv
		@found file {path}
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# PWA files are real files, never the SPA fallback. The worker and the manifest are revalidated on
	# every load so a deploy reaches installed apps; /app/sw.js gets scope /app/ from its own path.
	@pwa path /app/sw.js /app/offline.html
	handle @pwa {
		header Cache-Control "no-cache"
		root * /srv
		file_server
	}

	handle /app/manifest.webmanifest {
		header Cache-Control "no-cache"
		header Content-Type "application/manifest+json"
		root * /srv
		file_server
	}

	handle /app/icons/* {
		root * /srv
		@iconfound file {path}
		header @iconfound Cache-Control "public, max-age=86400"
		file_server
	}

	@bare path /app
	redir @bare /app/?{query} 308

	@spa path /app/*
	handle @spa {
		header Cache-Control "no-cache"
		root * /srv
		rewrite * /app/index.html
		file_server
	}

	handle {
		root * /srv
		file_server
	}

	# The site's own 404 has a body, so it is told apart from the operator block's empty 404.
	handle_errors {
		@notfound expression {http.error.status_code} == 404
		respond @notfound "Not found" 404
	}
}
