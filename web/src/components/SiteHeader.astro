---
import Logo from './Logo.astro';

const nav = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/paths', label: 'Paths' },
  { href: '/story', label: 'The story' },
];
---

<header class="relative z-20 mx-auto flex max-w-[1180px] items-center justify-between py-2.5 pr-2 pl-4 md:px-6 md:py-[18px]">
  <a href="/" class="flex items-center gap-2.5 text-fg no-underline" aria-label="Dojo home">
    <Logo size={28} />
    <span class="font-mono text-[17px] font-semibold md:text-lg">dojo</span>
  </a>

  <nav aria-label="Main" class="hidden gap-7 text-[15px] font-medium md:flex">
    {nav.map((n) => <a href={n.href} class="text-fg2 no-underline hover:text-fg">{n.label}</a>)}
  </nav>

  <div class="flex items-center gap-1">
    <a
      href="/app/signin"
      class="hidden h-10 items-center gap-2 rounded-[10px] bg-fg px-4 text-sm font-semibold text-bg no-underline md:inline-flex"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" class="fill-current"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z"></path></svg>
      Sign in
    </a>

    <details class="group md:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-[10px] text-fg [&::-webkit-details-marker]:hidden"
        aria-label="Menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="group-open:hidden" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="hidden group-open:block" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </summary>
      <div class="absolute top-full right-2 left-2 flex flex-col rounded-2xl border border-line bg-surface p-2 shadow-card">
        {nav.map((n) => (
          <a href={n.href} class="flex min-h-11 items-center rounded-[10px] px-3 text-[15px] font-medium text-fg2 no-underline">{n.label}</a>
        ))}
        <a
          href="/app/signin"
          class="mt-1 inline-flex h-11 items-center justify-center gap-2 rounded-[10px] bg-fg px-4 text-sm font-semibold text-bg no-underline"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" class="fill-current"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z"></path></svg>
          Sign in
        </a>
      </div>
    </details>
  </div>
</header>
