                <span class="text-lg font-extrabold">Support L1</span>
                <span class="font-mono text-xs text-muted">7/12</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-surface2"><div class="h-full w-[58%] rounded-full bg-accent"></div></div>
              <div class="mt-2 text-xs font-bold tracking-[0.6px] text-muted uppercase">Activity</div>
