---
import { PUBLIC_ORIGIN } from 'astro:env/client';
import Public from '../layouts/Public.astro';
import Terminal from '../components/Terminal.astro';

const host = new URL(PUBLIC_ORIGIN).host;
const heat = [
  [1, 0, 1, 0, 0, 2, 0],
  [1, 2, 1, 0, 1, 1, 2],
  [0, 1, 0, 0, 2, 1, 1],
  [2, 3, 1, 1, 1, 1, 2],
  [2, 2, 2, 4, 3, 4, 4],
  [1, 2, 4, 4, 0, 0, 2],
  [0, 1, 0, 3, 3, 4, 0],
  [3, 3, 0, 4, 4, 1, 4],
  [2, 2, 4, 4, 0, 2, 2],
  [1, 1, 1, 3, 0, 2, 2],
  [0, 1, 2, 2, 0, 4, 3],
  [4, 0, 1, 0, 3, 1, 0],
  [2, 4, 4, 1, 0, 4, 2],
  [3, 0, 0, 3, 2, 0, 4],
  [2, 3, 0, 4, 0, 4, 2],
  [1, 2, 4, 1, 0, 2, 1],
];
const heatClass = ['bg-[#f2f3f7]', 'bg-[#dcd3fd]', 'bg-[#a996f7]', 'bg-[#5ba3d9]', 'bg-[#0e7490]'];
const dark = 'bg-[#0e0f14]';
const light = 'bg-white';
const belts = [
  { marks: 4, bg: 'bg-white border border-[#c9cac4]', mark: dark },
  { marks: 2, bg: 'bg-[#e8c33a]', mark: dark },
  { marks: 0, bg: 'bg-[#e07a2e]', mark: light },
  { marks: 0, bg: 'bg-[#3c8d4f]', mark: light },
  { marks: 0, bg: 'bg-[#2f64b8]', mark: light },
  { marks: 0, bg: 'bg-[#7a5233]', mark: light },
  { marks: 0, bg: 'bg-[#0e0f12] border border-[#c9cac4]', mark: light },
];
---

<Public
  title="Dojo: learn the job by doing the job"
  description="Real tickets on servers that really break. Pick the job you want and pass a work day for each role on the way."
>
  <main class="relative z-[1]">
    <section class="mx-auto flex max-w-[1180px] flex-col items-center gap-5 px-4 pt-9 text-center md:gap-[26px] md:px-6 md:pt-[72px]">
      <a href="/paths" class="inline-flex h-[34px] items-center gap-2.5 rounded-full border border-line bg-white p-1.5 text-[13px] font-medium text-fg2 no-underline">
        <span class="inline-flex h-6 items-center rounded-full bg-accentsoft px-2.5 text-xs font-bold text-accentink">New</span>
        Systems and DevOps path
        <span class="pr-2" aria-hidden="true">→</span>
      </a>

      <h1 class="m-0 max-w-[1120px] text-[44px] leading-[1.04] font-extrabold tracking-[-1.6px] md:text-[76px] md:leading-[1.02] md:tracking-[-2.6px]">
        Learn the job <br class="hidden md:inline" /><span class="hl">by doing the job</span><span class="-ml-[0.12em]">.</span>
      </h1>

      <p class="m-0 max-w-[620px] text-base leading-[1.55] text-fg2 md:text-xl">Real tickets on servers that really break.</p>

      <div class="flex w-full flex-col items-stretch gap-2.5 md:w-auto md:flex-row md:items-center md:gap-3.5">
        <a href="/paths" class="inline-flex h-12 items-center justify-center gap-2 rounded-[10px] bg-accent px-[22px] text-base font-bold text-accentfg no-underline shadow-[0_8px_24px_var(--glow)]">
          Pick your path <span aria-hidden="true">→</span>
        </a>
        <div class="flex min-h-12 min-w-0 items-center gap-3 rounded-xl border border-line bg-surface py-1.5 pr-2 pl-4 text-left font-mono text-xs md:text-sm">
          <span class="text-muted" aria-hidden="true">$</span>
          <span class="min-w-0 flex-1 break-all md:whitespace-nowrap">curl -fsSL {host}/install | sh</span>
          <span class="flex h-[34px] flex-none items-center rounded-lg bg-surface2 px-2.5 font-sans text-[11px] font-semibold text-fg2">Coming soon</span>
        </div>
      </div>

      <div class="mt-4 w-full text-left md:hidden">
        <Terminal
          title="~/dojo, zsh"
          label="Terminal: dojo check runs, both checks pass and the ticket is passed."
          class="shadow-card"
        >
          <div><span class="text-[#6fcf97]">irene@laptop</span><span class="text-[#8c919b]">:</span><span class="text-[#8fa7f2]">~/dojo</span><span class="text-[#8c919b]">$ </span>dojo check</div>
          <div class="text-[#b9bdc4]">Rebooting the lab...</div>
          <div><span class="text-[#6fcf97]">✓</span> the team can write</div>
          <div><span class="text-[#6fcf97]">✓</span> nobody else can</div>
          <div>Ticket passed. <span class="text-[#8fa7f2]">[main 3f9a1c2]</span></div>
          <div><span class="text-[#6fcf97]">irene@laptop</span><span class="text-[#8c919b]">:</span><span class="text-[#8fa7f2]">~/dojo</span><span class="text-[#8c919b]">$ </span><span class="inline-block h-[15px] w-2 bg-[#e6e7e3] align-[-2px]"></span></div>
        </Terminal>
      </div>

      <div class="mt-9 hidden w-full max-w-[1100px] md:block" aria-hidden="true">
        <div class="flex flex-col overflow-hidden rounded-2xl border border-line bg-surface shadow-card">
          <div class="flex items-center gap-1.5 border-b border-line bg-surface2 px-3.5 py-2.5">
            <span class="size-2.5 rounded-full bg-line"></span>
            <span class="size-2.5 rounded-full bg-line"></span>
            <span class="size-2.5 rounded-full bg-line"></span>
            <span class="mx-auto rounded-md border border-line bg-surface px-10 py-[3px] font-mono text-xs text-muted">{host}/today</span>
          </div>
          <div class="grid min-h-[420px] text-left md:grid-cols-[150px_1fr] lg:grid-cols-[170px_1fr_280px]">
            <div class="flex flex-col gap-0.5 border-r border-line px-2.5 py-3.5">
              <div class="flex h-[34px] items-center gap-2.5 rounded-lg bg-accentsoft px-2.5 text-[13px] font-bold text-accentink">Today</div>
              <div class="flex h-[34px] items-center gap-2.5 rounded-lg px-2.5 text-[13px] text-fg2">Path</div>
              <div class="flex h-[34px] items-center gap-2.5 rounded-lg px-2.5 text-[13px] text-fg2">Practice</div>
            </div>
            <div class="flex min-w-0 flex-col gap-3.5 px-6 py-[22px]">
              <div class="font-mono text-xs text-muted">in progress · support-l1/perms-03</div>
              <div class="text-2xl leading-[1.15] font-extrabold tracking-[-0.6px]">The shared folder stopped accepting uploads</div>
              <div class="flex items-start gap-2.5 rounded-xl border border-line px-3.5 py-3">
                <div class="flex size-[30px] flex-none items-center justify-center rounded-full bg-[#e9dccb] text-[13px] font-bold text-[#5a3e1e]">M</div>
                <div class="text-[13px] leading-[1.5]"><b>Elena · Finance</b><br />Hi! The team can't save files in /srv/shared since the migration...</div>
              </div>
              <div class="overflow-hidden rounded-xl border border-[#2a2e36] bg-[#121419] font-mono text-[#e6e7e3]">
                <div class="flex items-center gap-1.5 bg-[#1c1f25] px-3 py-[9px]">
                  <span class="size-2.5 rounded-full bg-[#4a4f59]"></span>
                  <span class="size-2.5 rounded-full bg-[#4a4f59]"></span>
                  <span class="size-2.5 rounded-full bg-[#4a4f59]"></span>
                  <span class="mr-[42px] flex-1 text-center text-xs text-[#9095a0]">irene@laptop: ~/dojo, zsh</span>
                </div>
                <div class="px-4 py-3.5 text-xs leading-[1.75]">
                  <div><span class="text-[#6fcf97]">irene@laptop</span><span class="text-[#8c919b]">:</span><span class="text-[#8fa7f2]">~/dojo</span><span class="text-[#8c919b]">$ </span>dojo check</div>
                  <div class="text-[#b9bdc4]">Rebooting the lab...</div>
                  <div><span class="text-[#6fcf97]">✓</span> the team can write</div>
                  <div><span class="text-[#f28b82]">✗</span> nobody else can</div>
                  <div><span class="text-[#6fcf97]">irene@laptop</span><span class="text-[#8c919b]">:</span><span class="text-[#8fa7f2]">~/dojo</span><span class="text-[#8c919b]">$ </span><span class="inline-block h-[15px] w-2 bg-[#e6e7e3] align-[-2px]"></span></div>
                </div>
              </div>
            </div>
            <div class="hidden flex-col gap-3.5 border-l border-line p-[18px] lg:flex">
              <div class="text-xs font-bold tracking-[0.6px] text-muted uppercase">Role</div>
