        <article class="flex w-[300px] flex-none snap-start flex-col gap-[18px] overflow-hidden rounded-[20px] border border-line bg-surface p-5 md:w-auto md:p-[26px]">
          <div class="flex flex-col gap-1.5">
            <h3 class="m-0 text-[19px] font-extrabold tracking-[-0.3px]">Hints, not answers</h3>
            <p class="m-0 text-[15px] leading-[1.55] text-fg2">
              <span class="md:hidden">Written by people. Your own AI is told to mentor, not solve.</span>
